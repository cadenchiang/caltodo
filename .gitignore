# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
.next/
/out/

# Claude Code internal worktrees & caches
.claude/worktrees/
.claude/local/
.claude/settings.local.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# expo / react native
mobile/.expo/
mobile/android/
mobile/ios/
mobile/dist/

# serwist (PWA service worker — generated at build)
/public/sw.js
/public/sw.js.map
/public/swe-worker-*.js
/public/swe-worker-*.js.map
.gstack/

# Backups of pre-compression landing PNGs (re-creatable via scripts/compress-landing-images.mjs).
/public/originals/

# Tooling artifacts
/.lighthouseci/
/playwright-report/
/test-results/
/blob-report/
/e2e/.auth/
/playwright/.cache/
