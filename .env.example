# Supabase — get from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM encryption key for Gradescope password storage (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Google Calendar OAuth — get from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gcal/callback
# Must match the Google provider config in Supabase Auth settings
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend — email service for task sharing invites
# Get from https://resend.com > API Keys
RESEND_API_KEY=

# Anthropic — Claude API key for syllabus extraction
# Get from https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# PostHog analytics (optional) — get from https://posthog.com > Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
