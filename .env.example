# Supabase — get from Supabase Dashboard > Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AES-256-GCM encryption key for Gradescope password storage (32 bytes hex)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CREDENTIALS_ENCRYPTION_KEY=

# Google Calendar OAuth — get from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gcal/callback
# Must match the Google provider config in Supabase Auth settings
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Resend — email service for task sharing invites
# Get from https://resend.com > API Keys
RESEND_API_KEY=

# Anthropic — Claude API key for syllabus extraction
# Get from https://console.anthropic.com > API Keys
ANTHROPIC_API_KEY=

# Admin email for /app/admin and /api/admin/* access control
ADMIN_EMAIL=

# PostHog analytics (optional) — get from https://posthog.com > Project Settings
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Stripe — pricing, checkout, and customer portal
# All optional for local dev. If unset, the upgrade UI falls back to a dev
# grant (NODE_ENV=development only) so you can test gated features without
# real billing. Set these to test the full Stripe flow locally.
#
# 1. Test secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# 2. In the Stripe test dashboard, create a Product "Caltodo Pro" with two
#    recurring prices (monthly + annual). Paste the price IDs (price_...):
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
# 3. For local webhook events, run in a separate terminal:
#      stripe listen --forward-to localhost:3000/api/stripe/webhook
#    The CLI prints a signing secret (whsec_...). Paste it here.
STRIPE_WEBHOOK_SECRET=

# Poke MCP integration (optional) — exposes Canvas/Gradescope assignments to
# Poke over the Model Context Protocol at /api/mcp.
# 1. A random secret you paste into Poke's "API Key" field. Minimum 24 chars:
#      node -e "console.log('sk-caltodo-'+require('crypto').randomBytes(24).toString('hex'))"
POKE_MCP_API_KEY=
# 2. The caltodo (Supabase auth.users) id whose assignments the MCP server reads.
POKE_MCP_USER_ID=
